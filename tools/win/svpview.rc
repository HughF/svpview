 * SPDX-License-Identifier: GPL-3.0-or-later
 * Copyright (C) 2026 Hugh Frater
 *
 * svpview.rc — Windows resources: icon, version stamp, manifest.
 *
 * The strings come from sv_version.h itself, so the version on the file's
 * Properties tab is the one the About dialog shows. FILEVERSION takes four
 * integers rather than a string, and those are passed in by the Makefile,
 * which has already split the date and stripped the leading zeros — the
 * resource compiler reads 08 as a malformed octal constant.
 */
#include <windows.h>
#include "sv_version.h"

#ifndef SV_VER_A
#define SV_VER_A 0
#define SV_VER_B 0
#define SV_VER_C 0
#endif

1 ICON "svpview.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "svpview.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    SV_VER_A, SV_VER_B, SV_VER_C, 0
PRODUCTVERSION SV_VER_A, SV_VER_B, SV_VER_C, 0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"          /* UK English, Unicode */
        BEGIN
            VALUE "CompanyName",      "Hugh Frater"
            VALUE "FileDescription",  SVPVIEW_TAGLINE
            VALUE "FileVersion",      SVPVIEW_VERSION
            VALUE "InternalName",     SVPVIEW_NAME
            VALUE "LegalCopyright",   "Copyright (C) 2026 Hugh Frater. GPL-3.0-or-later."
            VALUE "OriginalFilename", "svpview.exe"
            VALUE "ProductName",      SVPVIEW_NAME
            VALUE "ProductVersion",   SVPVIEW_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
